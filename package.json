{
  "name": "@waronsaas/decks",
  "version": "0.1.0",
  "description": "wOS Decks: pitch decks and presentations your team owns. Build them by hand or let your own AI build them over MCP. Self-host free, or host with us.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/warOnSaaS/decks"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "server.mjs",
  "exports": {
    ".": "./server.mjs",
    "./tools.json": "./tools.json",
    "./wos-app.json": "./wos-app.json"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "DECKS_EXAMPLES=1 node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-timeout=180000 --test-concurrency=1 test/*.test.mjs",
    "tools:json": "node scripts/tools-json.mjs",
    "sync-kit": "node scripts/sync-kit.mjs",
    "shots": "node scripts/shots.mjs",
    "agent-run": "node scripts/agent-run.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "check": "node scripts/tools-json.mjs --check && node scripts/build.mjs --check && npm test && node scripts/check-clean.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sparticuz/chromium": "^147.0.0",
    "better-sqlite3": "^12.11.1",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "playwright-core": "1.63",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.63"
  }
}
